# Supply Chain Sentinel - Environment Variables
# Copy this file to .env and fill in your API keys

# ── Threat Intelligence ──────────────────────────────────────
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# ── AI Analysis ──────────────────────────────────────────────
# Providers: gemini, openai, anthropic, groq, ollama
SENTINEL_AI_PROVIDER=gemini
SENTINEL_AI_API_KEY=
SENTINEL_AI_MODEL=gemini-2.0-flash
SENTINEL_AI_ENABLED=true

# ── Analysis Settings ────────────────────────────────────────
# SENTINEL_TIMEOUT=60
# SENTINEL_ENABLE_DYNAMIC=false
# SENTINEL_MAX_PACKAGE_SIZE=104857600
# SENTINEL_ENTROPY_THRESHOLD=7.0

# ── Cache ────────────────────────────────────────────────────
# SENTINEL_CACHE_TTL=86400
# SENTINEL_CACHE_DIR=~/.sentinel/cache

# ── Debug ────────────────────────────────────────────────────
# SENTINEL_DEBUG=false
# SENTINEL_LOG_LEVEL=WARNING
